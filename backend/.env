# Server Configuration
PORT=5000
NODE_ENV=development

# Database - PostgreSQL
DATABASE_URL=postgresql://postgres:12345678@localhost:5432/tutorxpert

# MongoDB Atlas
MONGODB_URI=mongodb://127.0.0.1:27017/tutorxpert

# Redis
REDIS_URL=redis://localhost:6379

# JWT Secret
JWT_SECRET=tutorxpert-super-secret-jwt-key-change-in-production-2024

# Email (SendGrid/Resend)
EMAIL_SERVICE=sendgrid
EMAIL_API_KEY=your-email-api-key
EMAIL_FROM=noreply@tutorxpert.com

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# AI Microservice URL
AI_SERVICE_URL=http://localhost:8000

# Jitsi Meet API
JITSI_DOMAIN=meet.jit.si

# Session Secret
SESSION_SECRET=tutorxpert-session-secret-key-2024
